# Run python -m scripts.configure to generate an untracked .env with random secrets.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=flashmarket
DB_USER=flashmarket
DB_PASSWORD=replace-with-your-local-database-password
DB_ROOT_PASSWORD=replace-with-a-separate-local-root-password
ADMIN_API_KEY=replace-with-a-random-key-at-least-32-characters-long
DB_POOL_SIZE=10
SSE_MAX_CLIENTS=32
# Hosting may supply DATABASE_URL=mysql://user:password@host:3306/database instead.
# For external managed MySQL with a required CA certificate:
# DB_SSL_CA=/path/to/ca.pem

# A hosted service can provide its public CA PEM to start.sh.
# DB_SSL_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
