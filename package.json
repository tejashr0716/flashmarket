{
  "name": "flashmarket-browser-tests",
  "private": true,
  "description": "Optional browser test tools only; no Node runtime is needed by the application.",
  "type": "module",
  "scripts": {
    "test:browser": "node tests/browser/smoke.mjs",
    "test:invalidation": "node tests/browser/test_cache_invalidation.mjs",
    "test:cache-unit": "node --test tests/unit/test_frontend_cache.mjs",
    "bench:browser": "node scripts/bench_browser.mjs",
    "check:js": "node --check app/static/app.js"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
